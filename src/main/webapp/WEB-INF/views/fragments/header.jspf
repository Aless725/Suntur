<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${titulo}"/> | Suntur ERP</title>
    <link rel="stylesheet" href="${ctx}/css/bootstrap.min.css">
    <link rel="stylesheet" href="${ctx}/css/suntur.css">
</head>
<body>
<div class="app">
    <aside class="sidebar" id="menuLateral">
        <div class="marca">
            <strong>SUNTUR ERP</strong>
            <span>I.E. San José Marello N° 1220</span>
        </div>
        <nav>
            <a href="${ctx}/dashboard" class="${nav == 'dashboard' ? 'activo' : ''}">Tablero</a>
            <a href="${ctx}/estudiantes" class="${nav == 'estudiantes' ? 'activo' : ''}">Estudiantes</a>
            <c:if test="${usuarioActual.admin}">
                <a href="${ctx}/matriculas" class="${nav == 'matriculas' ? 'activo' : ''}">Matrículas</a>
            </c:if>
            <a href="${ctx}/notas" class="${nav == 'notas' ? 'activo' : ''}">Calificaciones</a>
            <a href="${ctx}/asistencias" class="${nav == 'asistencias' ? 'activo' : ''}">Asistencias</a>
            <c:if test="${usuarioActual.admin}">
                <a href="${ctx}/pagos" class="${nav == 'pagos' ? 'activo' : ''}">Pagos</a>
                <a href="${ctx}/pagos/actividades" class="${nav == 'actividades' ? 'activo' : ''}">Actividades</a>
            </c:if>
            <a href="${ctx}/reportes" class="${nav == 'reportes' ? 'activo' : ''}">Reportes</a>
        </nav>
        <div class="usuario">
            <div><c:out value="${usuarioActual.nombreCompleto}"/></div>
            <div class="rol"><c:out value="${usuarioActual.rol}"/></div>
            <a href="${ctx}/logout">Cerrar sesión</a>
        </div>
    </aside>
    <div class="principal">
        <header class="topbar">
            <button class="btn-menu" id="btnMenu" type="button" aria-label="Abrir menú">&#9776;</button>
            <h1><c:out value="${titulo}"/></h1>
            <span class="anio">Año académico <c:out value="${anioActual}"/></span>
        </header>
        <main class="contenido">
            <c:if test="${not empty ok}"><div class="aviso aviso-ok" role="status"><c:out value="${ok}"/></div></c:if>
            <c:if test="${not empty error}"><div class="aviso aviso-error" role="alert"><c:out value="${error}"/></div></c:if>
